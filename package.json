{
  "name": "cadence",
  "version": "0.2.5",
  "description": "All-in-one Discord music bot and real-time web dashboard built with TypeScript & Bun.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch server/index.ts",
    "dev:web": "bunx vite --config web/vite.config.ts",
    "build:web": "bunx vite build --config web/vite.config.ts",
    "start": "bun run server/index.ts",
    "typecheck:server": "bunx tsc -p tsconfig.server.json --noEmit",
    "typecheck:web": "bunx tsc -p tsconfig.web.json --noEmit",
    "typecheck": "bun run typecheck:server && bun run typecheck:web",
    "test": "bun test",
    "verify": "bun run typecheck && bun test && bun run build:web"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "hono": "^4.13.19",
    "lavalink-client": "^2.11.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}