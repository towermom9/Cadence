# ==============================================================================
# Cadence Configuration (Optional when using Web Onboarding)
#
# Quickest setup: skip editing `.env` and run `docker compose up -d --build`,
# then open http://localhost:8000 to complete the guided web onboarding wizard!
#
# Or copy this file to `.env` for headless / advanced configuration.
# ==============================================================================

# --- Optional: Protect First-Time Web Onboarding on Public Servers ------------
# If set, the web setup wizard will ask for this passcode before accepting keys.
SETUP_TOKEN=

# --- Discord Application Credentials (can also be entered in Web Onboarding) --
# Get these at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Dashboard & Server -------------------------------------------------------
# Public URL where you open the web dashboard.
# In Discord Developer Portal -> OAuth2 -> Redirects, add: ${DASHBOARD_URL}/api/auth/callback
DASHBOARD_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# Random secret used for session signing (auto-generated into ./data if left blank)
SESSION_SECRET=

# --- Bot Behavior -------------------------------------------------------------
BOT_PREFIX=?
# Options: ytmsearch (YouTube Music), ytsearch (YouTube), spsearch (Spotify), dzsearch (Deezer), scsearch (SoundCloud)
DEFAULT_SEARCH_SOURCE=ytmsearch

# --- Optional: Spotify (improves search & rate limits; works out of box via spotify-tokener) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Optional: Deezer (requires DEEZER_MASTER_KEY from a Deezer client/setup) -
DEEZER_ENABLED=false
DEEZER_ARL=
DEEZER_MASTER_KEY=

# --- Optional: Apple Music ----------------------------------------------------
APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_TOKEN=

# --- Optional: YouTube OAuth2 -------------------------------------------------
# Enable only if YouTube blocks anonymous playback on your network ("Sign in to confirm you're not a bot").
# Recommended to use a dedicated account rather than your primary Google account.
YT_OAUTH_ENABLED=false
YT_OAUTH_REFRESH_TOKEN=

# --- Lavalink Audio Server ----------------------------------------------------
# Docker Compose overrides LAVALINK_HOST=lavalink automatically inside the container.
# When running Cadence locally with `bun run dev` against Dockerized Lavalink, keep `localhost`.
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
